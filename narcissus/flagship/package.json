{
  "name": "narcissus-flagship",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Narcissus flagship — the TELOS development-story front-end ('Loom on Trial'). WebGL is paint; XState is truth.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "npm run check:live-graph",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4317",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "node --test scripts/test-build-live-graph.mjs scripts/test-verify-evidence.mjs",
    "test:unit:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 scripts/test-build-live-graph.mjs scripts/test-verify-evidence.mjs",
    "test:e2e": "playwright test tests/e2e/flagship.spec.ts",
    "capture:evidence": "playwright test tests/e2e/screenshots.spec.ts tests/e2e/motion.capture.spec.ts",
    "verify:evidence": "node scripts/verify-evidence.mjs",
    "verify:coverage": "node scripts/verify-coverage.mjs",
    "build:live-graph": "node scripts/build-live-graph.mjs",
    "check:live-graph": "node scripts/build-live-graph.mjs --check",
    "prebuild": "npm run check:live-graph",
    "lint": "eslint ."
  },
  "dependencies": {
    "@react-three/fiber": "^8.17.10",
    "@xstate/react": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^19.2.8",
    "three": "^0.169.0",
    "xstate": "^5.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.1.5"
  }
}
