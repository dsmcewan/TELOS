{
  "name": "narcissus-flagship",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Narcissus flagship \u2014 native DOM, state reducer and WebGL; zero runtime, build and test packages.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node native/scripts/server.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node native/scripts/server.mjs dist",
    "test": "node --test native/tests/*.test.mjs scripts/test-*.mjs",
    "test:unit": "node --test native/tests/*.test.mjs scripts/test-*.mjs",
    "test:e2e": "node native/scripts/test-browser.mjs dist .verification/browser.json",
    "capture:evidence": "node native/scripts/capture.mjs",
    "verify:evidence": "node scripts/verify-evidence.mjs",
    "verify:coverage": "node scripts/verify-coverage.mjs .verification/browser.json",
    "build:live-graph": "node scripts/build-live-graph.mjs",
    "check:live-graph": "node scripts/build-live-graph.mjs --check",
    "check:dependencies": "node ../../tools/check-zero-dependencies.mjs"
  }
}
